# Load balancer of the cluster test stack (docker-compose.cluster.yml):
# every request to any API process, round robin. No TLS: loopback only.

{
	admin off
	auto_https off
	servers {
		# gRPC clients speak HTTP/2 without TLS (h2c) to this local port.
		protocols h1 h2c
	}
}

:8080 {
	# A session's WebSocket: an HTTP/1.1 upgrade, which can't travel over
	# h2c.
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @websocket {
		reverse_proxy {
			dynamic a api 8080 {
				refresh 2s
			}
			lb_policy round_robin
			lb_try_duration 5s
			flush_interval -1
			transport http {
				versions 1.1
				read_timeout 0
				write_timeout 0
			}
		}
	}
	handle {
		reverse_proxy {
			dynamic a api 8080 {
				refresh 2s
			}
			lb_policy round_robin
			lb_try_duration 5s
			flush_interval -1
			transport http {
				versions h2c 1.1
				read_timeout 0
				write_timeout 0
			}
		}
	}
}
