# nbsandbox production settings for deploy/docker-compose.yml.
# Copy to deploy/.env and edit. See docs/deployment.md.

# Public host name and TLS: "internal" (Caddy's own CA) or your e-mail for
# Let's Encrypt (the host name must resolve to this server, ports 80/443 open).
NBSANDBOX_DOMAIN=nbsandbox.example.com
NBSANDBOX_TLS=you@example.com

# The docker group's id on this host: getent group docker | cut -d: -f3
DOCKER_GID=999

# Database password for the bundled PostgreSQL (long and random, e.g.
# openssl rand -hex 24). The database lives in the volume nbsandbox_pgdata.
NBSANDBOX_DB_PASSWORD=change-me

# Secret key of the bundled object storage (RustFS), long and random
# (openssl rand -hex 24). File contents live in the volume nbsandbox_objects.
NBSANDBOX_S3_SECRET_KEY=change-me

# Data directory: same absolute path on the host and in the container,
# owned by uid 1000, mode 700 (scripts/preflight.sh checks it).
NBSANDBOX_DATA_DIR=/srv/nbsandbox

# Settings and users files (users.yaml: chmod 600, owned by uid 1000).
NBSANDBOX_SETTINGS=/etc/nbsandbox/settings.yaml
NBSANDBOX_USERS=/etc/nbsandbox/users.yaml

# Images (pinned release versions).
NBSANDBOX_IMAGE=ghcr.io/azbyluthfan/nbsandboxd:0.1.0
NBSANDBOX_RUNNER_IMAGE=ghcr.io/azbyluthfan/nbsandbox-runner:0.1.0
