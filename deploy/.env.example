# nbsandbox production settings for deploy/docker-compose.yml.
# Copy to deploy/.env and edit. See docs/deployment.md.

# Public host name and TLS: "internal" (Caddy's own CA) or your e-mail for
# Let's Encrypt (the host name must resolve to this server, ports 80/443 open).
NBSANDBOX_DOMAIN=nbsandbox.example.com
NBSANDBOX_TLS=you@example.com

# The docker group's id on this host: getent group docker | cut -d: -f3
DOCKER_GID=999

# Database password for the bundled PostgreSQL (long and random, e.g.
# openssl rand -hex 24). The database lives in the volume nbsandbox_pgdata.
NBSANDBOX_DB_PASSWORD=change-me

# Secret key of the bundled object storage (RustFS), long and random
# (openssl rand -hex 24). File contents live in the volume nbsandbox_objects.
NBSANDBOX_S3_SECRET_KEY=change-me

# Data directory: same absolute path on the host and in the container,
# owned by uid 1000, mode 700 (scripts/preflight.sh checks it).
NBSANDBOX_DATA_DIR=/srv/nbsandbox

# Settings and users files (users.yaml: chmod 600, owned by uid 1000).
NBSANDBOX_SETTINGS=/etc/nbsandbox/settings.yaml
NBSANDBOX_USERS=/etc/nbsandbox/users.yaml

# Images (pinned release versions).
NBSANDBOX_IMAGE=ghcr.io/azbyluthfan/nbsandboxd:0.5.0
NBSANDBOX_RUNNER_IMAGE=ghcr.io/azbyluthfan/nbsandbox-runner:0.5.0

# The web UI, with sign-in (docs/auth.md#signing-in-to-the-web-ui). Off by
# default; Caddy serves it at https://NBSANDBOX_DOMAIN/ when on.
#NBSANDBOX_UI_ENABLED=true
#NBSANDBOX_UI_AUTH=oidc                 # or basic (users.yaml)
#NBSANDBOX_UI_OIDC_CLIENT_ID=nbsandbox-ui
#NBSANDBOX_UI_OIDC_CLIENT_SECRET=change-me

# A space's own Python packages (docs/packages.md). Off by default: build
# containers are the only ones with network.
#NBSANDBOX_PACKAGES_ENABLED=true
#NBSANDBOX_PACKAGES_INDEX_URL=https://pypi.org/simple
#NBSANDBOX_PACKAGES_ALLOWED=            # e.g. humanize,tabulate; empty = any
#NBSANDBOX_PACKAGES_BUILDER_IMAGE=ghcr.io/azbyluthfan/nbsandbox-runner-builder:0.5.0

# Connections: notebooks read databases and object storage where they live
# (docs/connections.md). Off by default. On: set both keys (each
# openssl rand -base64 32; losing the master key loses every stored secret),
# list where connections may point, and start the egress gateway too:
# COMPOSE_PROFILES=connections (or docker compose --profile connections up -d).
#NBSANDBOX_CONNECTIONS_ENABLED=true
#NBSANDBOX_CONNECTIONS_MASTER_KEY=change-me
#NBSANDBOX_GATEWAY_KEY=change-me
#NBSANDBOX_CONNECTIONS_ALLOWED=*.db.internal,10.20.0.0/16
#NBSANDBOX_FETCHER_IMAGE=ghcr.io/azbyluthfan/nbsandbox-fetcher:0.5.0
#COMPOSE_PROFILES=connections
