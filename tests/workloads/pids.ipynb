    "import subprocess\n",
    "procs = []\n",
    "while True:\n",
    "    procs.append(subprocess.Popen(['sleep', '300']))\n",
    "    if len(procs) % 50 == 0:\n",
    "        print(len(procs), 'processes', flush=True)"
   ]
